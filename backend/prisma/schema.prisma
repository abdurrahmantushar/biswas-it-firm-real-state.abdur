generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

model fromdata {
  id            Int      @id @default(autoincrement())
  name          String
  email         String  
  phone         String
  apartmentType String
  message       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}
